def find_claude():
    import shutil
    for c in (shutil.which("claude"), os.path.join(BIN, "claude"), os.path.join(HOME, ".claude", "local", "claude")):
        if c and os.access(c, os.X_OK):
            return c
    raise SystemExit("baton: can't find the claude command")


def clean_env(d):
    """Our environment minus the running session's markers (a child session doesn't save its transcript)."""
    env = {k: v for k, v in os.environ.items() if not (k == "CLAUDECODE" or k.startswith("CLAUDE_CODE_"))}
    env.pop("CLAUDE_CONFIG_DIR", None)
    if not is_default(d):
        env["CLAUDE_CONFIG_DIR"] = d
    return env


def start_cmd(name, d):
    """What a person would type to start this account."""
    import shutil
    if is_default(d):
        return "claude"
    if shutil.which(name) and "baton launcher" in read(shutil.which(name)):
        return name
    folder = '"$HOME' + d[len(HOME):] + '"' if d.startswith(HOME + os.sep) else quote(d)
    return f"CLAUDE_CONFIG_DIR={folder} claude"


def start_line(name, d, prompt):
    return f"{start_cmd(name, d)} {quote(prompt)}"


def open_window(cwd, inner, env):
    """Run a shell command in a new terminal window (tmux, macOS Terminal/iTerm, or a Linux terminal)."""
    import shutil
    import subprocess

    def spawn(argv):
        try:
            p = subprocess.Popen(argv, cwd=cwd, env=env, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL, start_new_session=True)
        except OSError:
            return False
        try:
            return p.wait(timeout=1.5) == 0
        except subprocess.TimeoutExpired:
            return True  # still running: the window is open

    if os.environ.get("TMUX") and shutil.which("tmux"):
        return spawn(["tmux", "new-window", "-c", cwd, inner])
    if sys.platform == "darwin":
        s = f"cd {quote(cwd)} && {inner}".replace("\\", "\\\\").replace('"', '\\"')
        if os.environ.get("TERM_PROGRAM") == "iTerm.app":
            script = ('tell application "iTerm"\nactivate\nset w to (create window with default profile)\n'
                      f'tell current session of w to write text "{s}"\nend tell')
        else:
            script = f'tell application "Terminal"\nactivate\ndo script "{s}"\nend tell'
        return spawn(["osascript", "-e", script])
    run = ["/bin/sh", "-c", inner]
    for t in linux_terminals():
        if spawn([t, *TERMS.get(t, ["-e"]), *run]):
            return True
    return False


TERMS = {"gnome-terminal": ["--"], "kitty": [], "wezterm": ["start", "--"], "alacritty": ["-e"], "ghostty": ["-e"],
         "konsole": ["-e"], "foot": [], "xfce4-terminal": ["-x"], "xterm": ["-e"], "x-terminal-emulator": ["-e"]}


def linux_terminals():
    """Installed terminals to open a window with: the one we run in first (its variables reach Claude's shell),
    then $TERMINAL, then the rest. Empty without a display."""
    import shutil
    if not (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
        return []
    here = [t for v, t in (("KITTY_WINDOW_ID", "kitty"), ("WEZTERM_PANE", "wezterm"), ("ALACRITTY_WINDOW_ID", "alacritty"),
                           ("GHOSTTY_RESOURCES_DIR", "ghostty"), ("KONSOLE_VERSION", "konsole"),
                           ("GNOME_TERMINAL_SCREEN", "gnome-terminal")) if os.environ.get(v)]
    custom = os.environ.get("TERMINAL")
    return [t for t in dict.fromkeys(here + ([custom] if custom else []) + list(TERMS)) if shutil.which(t)]


def window_method():
    import shutil
    if os.environ.get("TMUX") and shutil.which("tmux"):
        return "tmux"
    if sys.platform == "darwin":
        return "iTerm" if os.environ.get("TERM_PROGRAM") == "iTerm.app" else "Terminal"
    found = linux_terminals()
    return found[0] if found else None


def cmd_next(args):
    flags = {a for a in args if a.startswith("--")}
    prompt = " ".join(a for a in args if not a.startswith("--")) or PROMPT
    pick = roomiest()
    if not pick:
        soon = soonest_reset()
        print("Every account is near its limit" + (f"; {soon[1]} resets first, at {clock(soon[0], True)}." if soon else "."))
        return 1
    name, d, pct = pick
    cwd = os.getcwd()
    line = f"cd {quote(cwd)} && {start_line(name, d, prompt)}"
    if "--print" in flags:
        print(line)
        return 0
    env, claude = clean_env(d), find_claude()
    if "--window" in flags:
        drop = " ".join(f"-u {k}" for k in sorted(os.environ) if k == "CLAUDECODE" or k.startswith("CLAUDE_CODE_"))
        cfg = "-u CLAUDE_CONFIG_DIR" if is_default(d) else f"CLAUDE_CONFIG_DIR={quote(d)}"
        inner = f'env {drop} {cfg} {quote(claude)} {quote(prompt)}; exec "${{SHELL:-/bin/sh}}"'
        if open_window(cwd, inner, env):
            print(f"Opened {name}" + (f" ({pct:.0f}% used)" if pct is not None else "") + f" in a new window, in {tilde(cwd)}.")
            return 0
        print(f"Couldn't open a terminal window. Run this in a terminal:\n  {line}")
        return 2
    print(f"baton: continuing on {name}" + (f" ({pct:.0f}% used)" if pct is not None else ""), file=sys.stderr)
    os.execve(claude, [claude, prompt], env)


