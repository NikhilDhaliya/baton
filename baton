#!/usr/bin/env python3
"""baton: several Claude Code accounts that work as one Claude.

  baton scan [--usage]                      what this computer has; changes and sends nothing (start here)
  baton init [--remote URL | --github NAME] [--no-handoff] [--no-statusline]
                                            set up ~/.baton (shared rules and memory, a git repo), join ~/.claude
  baton add [NAME] [--dir FOLDER]           add an account: `baton add` makes ~/.claude-b, started with `claudeb`
  baton status                              usage of every account
  baton next [--window] [--print] [PROMPT]  continue on the account with the most room
  baton sync                                commit, pull and push ~/.baton
  baton doctor                              check the setup
  baton leave DIR                           take one account folder out of baton (restores its backups)
  baton update                              install the latest baton

Installed into each account's settings.json: `hook start` (SessionStart), `hook usage` (UserPromptSubmit,
PostToolUse), `hook stop` (Stop) and `statusline`. Python 3.8+, standard library only. MIT licence.
https://github.com/NikhilDhaliya/baton
"""
import os
import sys
import time

VERSION = "0.1.0"
REPO_RAW = "https://raw.githubusercontent.com/NikhilDhaliya/baton/main/baton"
HOME = os.path.expanduser("~")
BATON = os.path.abspath(os.path.expanduser(os.environ.get("BATON_HOME") or "~/.baton"))
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"), "baton")
BIN = os.path.join(HOME, ".local", "bin")
SCRIPT = os.path.realpath(__file__)
USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
if os.environ.get("BATON_USAGE_URL", "").startswith(("http://127.0.0.1:", "http://localhost:")):
    USAGE_URL = os.environ["BATON_USAGE_URL"]  # tests only: a token never goes anywhere but Anthropic or this computer
PROMPT = "Read HANDOFF.md and continue."
SHARED = ("agents", "skills", "commands")  # folders every account shares, besides CLAUDE.md and memory
FRESH, REMIND = 180, 600  # seconds: how long a usage reading lasts; gap between handoff reminders
INDEX_LINES = 200  # Claude Code loads this many lines of MEMORY.md

_config = None


# ---------------------------------------------------------------- config, accounts, usage

def config():
    global _config
    if _config is None:
        import json
        try:
            with open(os.path.join(BATON, "local.json")) as f:
                _config = json.load(f)
        except (OSError, ValueError):
            _config = {}
    return _config


def save_config(cfg):
    import json
    global _config
    _config = cfg
    write(os.path.join(BATON, "local.json"), json.dumps(cfg, indent=2) + "\n")


def write(path, text):
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w") as f:
        f.write(text)
    try:
        os.chmod(tmp, os.stat(path).st_mode & 0o7777)  # keep the file's permissions
    except OSError:
        pass
    os.replace(tmp, path)


def read(path, default=""):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()
    except (OSError, UnicodeDecodeError):
        return default


def accounts():
    """[(name, folder)] in the order they were added."""
    return [(n, os.path.expanduser(d)) for n, d in config().get("accounts", {}).items()]


def features():
    f = config().get("features", {})
    return {"handoff": f.get("handoff", True), "statusline": f.get("statusline", True)}


def threshold():
    return float(os.environ.get("BATON_THRESHOLD") or config().get("threshold", 95))


def current():
    """The account folder of the Claude Code session that started us."""
    return os.path.realpath(os.path.expanduser(os.environ.get("CLAUDE_CONFIG_DIR") or "~/.claude"))


def same(a, b):
    return os.path.realpath(a) == os.path.realpath(b)


def is_default(d):
    return same(d, os.path.join(HOME, ".claude"))


def name_of(d):
    for n, ad in accounts():
        if same(ad, d):
            return n
    return tilde(d)


def tilde(path):
    return "~" + path[len(HOME):] if path == HOME or path.startswith(HOME + os.sep) else path


def cache_file(d, kind="usage"):
    """usage: the last reading. ok: exists while the account is under the threshold; the hook command checks its
    age in shell and starts Python only when it's missing or older than FRESH."""
    return os.path.join(CACHE, kind + os.path.realpath(d).replace(os.sep, "%"))


def usage(d, max_age=FRESH):
    """{at, five, five_reset, week, week_reset} or {at, error}; read at most every max_age seconds."""
    import json
    try:
        with open(cache_file(d)) as f:
            u = json.load(f)
        if time.time() - u["at"] < max_age:
            return u
    except (OSError, ValueError, KeyError):
        pass
    return fetch(d)


def fetch(d):
    import json
    u = read_usage(d)
    os.makedirs(CACHE, exist_ok=True)
    write(cache_file(d), json.dumps(u))
    pct = level(u)[0]
    if pct is not None and pct < threshold():
        open(cache_file(d, "ok"), "w").close()
    elif os.path.exists(cache_file(d, "ok")):
        os.remove(cache_file(d, "ok"))
    return u


def read_usage(d):
    import json
    import urllib.error
    import urllib.request
    u = {"at": time.time()}
    try:
        req = urllib.request.Request(USAGE_URL, headers={
            "Authorization": "Bearer " + token(d), "anthropic-beta": "oauth-2025-04-20",
            "User-Agent": "baton/" + VERSION})
        class NoRedirect(urllib.request.HTTPRedirectHandler):
            def redirect_request(self, *args, **kwargs):
                return None  # a redirect would carry the token to another host: stop (reported as HTTP 3xx)

        data = json.load(urllib.request.build_opener(NoRedirect).open(req, timeout=6))
        for key, window in (("five", "five_hour"), ("week", "seven_day")):
            w = data.get(window) or {}
            u[key], u[key + "_reset"] = w.get("utilization"), epoch(w.get("resets_at"))
    except LookupError:
        u["error"] = "not signed in"
    except urllib.error.HTTPError as e:
        u["error"] = "sign-in expired: open this account once" if e.code == 401 else f"HTTP {e.code}"
    except Exception:
        u["error"] = "offline"
    return u


def token(d):
    """The account's Claude Code access token: .credentials.json, or the macOS Keychain. Never printed."""
    import json
    try:
        with open(os.path.join(d, ".credentials.json")) as f:
            return json.load(f)["claudeAiOauth"]["accessToken"]
    except (OSError, ValueError, KeyError, TypeError):
        pass
    if sys.platform == "darwin":
        import hashlib
        import subprocess
        # Claude Code names the item after a hash of CLAUDE_CONFIG_DIR for any folder but the default one
        names = ["Claude Code-credentials"] if is_default(d) else [
            "Claude Code-credentials-" + hashlib.sha256(p.encode()).hexdigest()[:8]
            for p in dict.fromkeys([d, os.path.realpath(d)])]
        for n in names:
            r = subprocess.run(["security", "find-generic-password", "-s", n, "-w"], capture_output=True, text=True)
            if r.returncode == 0:
                try:
                    return json.loads(r.stdout)["claudeAiOauth"]["accessToken"]
                except (ValueError, KeyError, TypeError):
                    pass
    raise LookupError(d)


def signed_in(d):
    """Whether the account has a sign-in, without reading the secret itself (no Keychain prompt on macOS)."""
    if os.path.exists(os.path.join(d, ".credentials.json")):
        return True
    if sys.platform == "darwin":
        import hashlib
        import subprocess
        names = ["Claude Code-credentials"] if is_default(d) else [
            "Claude Code-credentials-" + hashlib.sha256(p.encode()).hexdigest()[:8]
            for p in dict.fromkeys([d, os.path.realpath(d)])]
        return any(subprocess.run(["security", "find-generic-password", "-s", n], capture_output=True).returncode == 0
                   for n in names)
    return False


def epoch(iso):
    if not iso:
        return None
    import datetime
    import re
    try:  # Python 3.8 can't read "Z" or more than 6 decimals
        iso = re.sub(r"(\.\d{6})\d+", r"\1", iso.replace("Z", "+00:00"))
        return datetime.datetime.fromisoformat(iso).timestamp()
    except ValueError:
        return None


def level(u):
    """The tighter of the two limits: (percent or None, window name, reset time)."""
    best = (None, None, None)
    for key, window in (("five", "5-hour"), ("week", "weekly")):
        p = u.get(key)
        if p is not None and (best[0] is None or float(p) > best[0]):
            best = (float(p), window, u.get(key + "_reset"))
    return best


def roomiest(exclude=None):
    """(name, folder, percent) of the account with the most room under the threshold; one whose usage can't be
    read comes after every readable one; None when every account is over."""
    th, best, unread = threshold(), None, None
    for name, d in accounts():
        if exclude and same(d, exclude):
            continue
        pct = level(usage(d))[0]
        if pct is None:
            unread = unread or (name, d, None)
        elif pct < th and (best is None or pct < best[2]):
            best = (name, d, pct)
    return best or unread


def soonest_reset(exclude=None):
    times = [(level(usage(d))[2], n) for n, d in accounts() if not (exclude and same(d, exclude))]
    times = [t for t in times if t[0]]
    return min(times) if times else None


def clock(ts, with_day=False):
    if not ts:
        return ""
    fmt = "%a %H:%M" if with_day and ts - time.time() > 20 * 3600 else "%H:%M"
    return time.strftime(fmt, time.localtime(ts))


# ---------------------------------------------------------------- hooks

def read_event():
    import json
    try:
        return json.load(sys.stdin)
    except ValueError:
        return {}


def emit(event_name, context, status=None):
    import json
    out = {"hookSpecificOutput": {"hookEventName": event_name, "additionalContext": context}}
    if status:
        out["systemMessage"] = status
    print(json.dumps(out))


def cli():
    """How to call this script in text Claude or the user will run."""
    import shutil
    found = shutil.which("baton")
    return "baton" if found and same(found, SCRIPT) else quote(SCRIPT)


def redact(text):
    """Hide a password or token inside a URL (https://user:secret@host)."""
    import re
    return re.sub(r"(://)[^/@\s]+@", r"\1***@", text)


def quote(s):
    import shlex
    return shlex.quote(s)


def hook_usage():
    """UserPromptSubmit and PostToolUse: near the limit, tell Claude to write HANDOFF.md and move on."""
    d = current()
    pct, window, _ = level(usage(d))
    th = threshold()
    if pct is None or pct < th:
        return  # the usual path: one small file read
    event = read_event()
    marker = os.path.join(CACHE, "reminded-" + str(event.get("session_id") or "none").replace(os.sep, "_"))
    try:
        if time.time() - os.path.getmtime(marker) < REMIND:
            return
    except OSError:
        pass
    os.makedirs(CACHE, exist_ok=True)
    open(marker, "w").close()
    cwd, me = event.get("cwd") or os.getcwd(), name_of(d)
    steps = (f"USAGE HANDOFF (baton, the user's standing rule): {me} is at {pct:.0f}% of its {window} limit (handoff "
             f"at {th:.0f}%). Before anything else: 1) finish only the edit in progress; 2) write or update HANDOFF.md "
             f"in {cwd} so a fresh session can carry on with nothing else: goal, decisions, done, in progress (exact "
             f"files, commands, running jobs), next steps; 3) stop your background agents and jobs; ")
    nxt = roomiest(exclude=d)
    if nxt:
        status = f"{me} at {pct:.0f}%: handing off to {nxt[0]}"
        context = steps + (f"4) run `cd {quote(cwd)} && {cli()} next --window`: it opens {nxt[0]} in a new terminal there with "
                           f"\"{PROMPT}\" (if it can't open a window, give the user the command it prints); 5) tell "
                           f"the user in one line that the work moved to {nxt[0]}, then stop.")
    else:
        soon = soonest_reset(exclude=d)
        when = f"; the first to reset is {soon[1]} at {clock(soon[0], True)}" if soon else ""
        status = f"{me} at {pct:.0f}%: every account is near its limit"
        context = steps + f"4) every account is near its limit{when}. Tell the user in one line, then stop."
    emit(event.get("hook_event_name") or "PostToolUse", context, status)


def hook_start():
    """SessionStart on this machine: pull the shared repo; say what changed elsewhere and what needs tidying."""
    if os.environ.get("CLAUDE_CODE_REMOTE") == "true" or not is_repo():
        return
    read_event()
    before = rev("HEAD")
    sync(push=True, wait=30)
    notes = []
    target = upstream()
    if before and target and rev("HEAD") != before:
        base = git("merge-base", before, target).stdout.strip()
        changed = git("diff", "--name-only", base, target).stdout.split() if base else []
        if changed:
            notes.append(f"Shared files changed on another machine (in {tilde(BATON)}); this session may have loaded "
                         f"the old ones. Read the ones your task touches:\n" + "\n".join("  " + c for c in changed))
    notes += tidy_notes()
    if notes:
        emit("SessionStart", "\n\n".join(notes))


def hook_stop():
    """Stop (runs async): commit and push the shared repo when something changed."""
    if os.environ.get("CLAUDE_CODE_REMOTE") == "true" or not is_repo():
        return
    if needs_sync():
        sync(push=True, wait=0)


def hook_cloud_start():
    """SessionStart in a Claude Code cloud session opened on the baton repo (its .claude/settings.json)."""
    if os.environ.get("CLAUDE_CODE_REMOTE") != "true":
        return
    read_event()
    root = os.environ.get("CLAUDE_PROJECT_DIR") or os.path.dirname(os.path.dirname(SCRIPT))
    if not os.path.lexists(BATON):
        os.symlink(root, BATON)
    sync(push=False, wait=30)
    index = read(os.path.join(BATON, "memory", "MEMORY.md"))
    notes = [f"Cloud session on the baton repo: shared memory is {tilde(BATON)}/memory (this repo's memory/). Save "
             f"lasting facts there; every reply is committed and pushed, so the user's other machines and accounts "
             f"get them.\n\nMemory index (memory/MEMORY.md):\n{index}"] + tidy_notes()
    emit("SessionStart", "\n\n".join(notes))


def hook_cloud_stop():
    if os.environ.get("CLAUDE_CODE_REMOTE") == "true" and is_repo() and needs_sync():
        sync(push=True, wait=0)


def tidy_notes():
    """Clashes a sync merged, other sides it saved, and a memory index that's too long or missing files."""
    import re
    notes = []
    secrets_log = os.path.join(BATON, ".git", "baton-secrets")
    secret = sorted(set(read(secrets_log).split("\n")) - {""})
    if secret:
        os.remove(secrets_log)
        notes.append(f"Not synced, because they look like they hold a secret (a key, token or password); they stay on "
                     f"this computer only. Tell the user. A new file that holds no secret: remove its line from "
                     f"{tilde(BATON)}/.git/info/exclude:\n" + "\n".join("  " + x for x in secret))
    notice_log = os.path.join(BATON, ".git", "baton-notice")
    told = sorted(set(read(notice_log).split("\n")) - {""})
    if told:
        os.remove(notice_log)
        notes += told
    merged_log = os.path.join(BATON, ".git", "baton-merged")
    merged = sorted(set(read(merged_log).split("\n")) - {""})
    if merged:
        os.remove(merged_log)
        notes.append("A sync merged a clash by keeping both sides' lines (nothing was lost). Check these files in "
                     f"{tilde(BATON)} for doubled or contradicting lines and tidy them (newer wins only where they truly "
                     "contradict):\n" + "\n".join("  " + m for m in merged))
    others, memory_files = [], []
    for top, dirs, files in os.walk(BATON):
        dirs[:] = [x for x in dirs if x != ".git"]
        for f in files:
            rel = os.path.relpath(os.path.join(top, f), BATON)
            if re.search(r"\.other(\.|$)", f):
                others.append(rel)
            elif rel.startswith("memory" + os.sep) and f.endswith(".md") and f != "MEMORY.md":
                memory_files.append(rel[len("memory") + 1:])
    if others:
        notes.append("These files hold the other side of a clash that couldn't be merged line by line. Combine each "
                     "with its original, then delete it:\n" + "\n".join("  " + o for o in others))
    index = read(os.path.join(BATON, "memory", "MEMORY.md"))
    lines = index.count("\n")
    if lines > INDEX_LINES:
        notes.append(f"memory/MEMORY.md is {lines} lines; Claude Code loads only the first {INDEX_LINES}. Shorten it "
                     "(one short line per memory) when you next save to memory.")
    missing = [m for m in memory_files if m not in index]
    if missing:
        notes.append("Memory files missing from MEMORY.md (add one line each, or delete them if they're stale):\n"
                     + "\n".join("  " + m for m in missing[:20]))
    return notes


# ---------------------------------------------------------------- git sync

_who = None


def git(*args, timeout=60, cwd=None):
    import subprocess
    global _who
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0")
    env.setdefault("GIT_SSH_COMMAND", "ssh -o BatchMode=yes")
    if args and args[0] in ("commit", "rebase", "merge"):
        args = ("-c", "commit.gpgsign=false") + args  # a background sync can't answer a signing prompt
        if _who is None:  # commits need a name; a fresh machine or cloud box may have none
            r = subprocess.run(["git", "config", "user.email"], cwd=cwd or BATON, capture_output=True, text=True)
            _who = {} if r.stdout.strip() else {f"GIT_{k}_{f}": v for k in ("AUTHOR", "COMMITTER")
                                                 for f, v in (("NAME", "baton"), ("EMAIL", "baton@localhost"))}
        env = {**_who, **env}
    try:
        return subprocess.run(["git", *args], cwd=cwd or BATON, capture_output=True, text=True, timeout=timeout, env=env)
    except (subprocess.TimeoutExpired, OSError) as e:
        return subprocess.CompletedProcess(args, 124, "", str(e))


def is_repo():
    return os.path.isdir(os.path.join(BATON, ".git"))


def rev(ref):
    r = git("rev-parse", "--verify", "-q", ref)
    return r.stdout.strip() if r.returncode == 0 else None


def branch():
    """The branch the shared repo syncs: the remote's default (a cloud session may sit on its own branch)."""
    r = git("symbolic-ref", "-q", "--short", "refs/remotes/origin/HEAD")
    if r.returncode == 0 and r.stdout.strip():
        return r.stdout.strip().split("/", 1)[1]
    r = git("symbolic-ref", "-q", "--short", "HEAD")
    return r.stdout.strip() or "main"


def upstream():
    ref = "origin/" + branch()
    return ref if rev(ref) else None


def has_remote():
    return bool(git("remote").stdout.split())


def needs_sync():
    """Local edits, or commits the remote doesn't have."""
    if git("status", "--porcelain").stdout.strip():
        return True
    target = upstream()
    if not target:
        return has_remote()
    return git("merge-base", "--is-ancestor", "HEAD", target).returncode != 0


def ensure_merge_driver():
    want = f"{quote(sys.executable)} {quote(SCRIPT)} merge %O %A %B %P"
    if git("config", "--get", "merge.baton.driver").stdout.strip() != want:
        git("config", "merge.baton.name", "baton: keep both sides")
        git("config", "merge.baton.driver", want)


SECRET_NAME = r"(^|/)(\.env(\.[^/]*)?|[^/]*\.(pem|key|p12|pfx)|id_(rsa|dsa|ecdsa|ed25519)|\.?credentials\.json|\.netrc)$"
SECRET_TEXT = (r"sk-ant-[\w-]{20,}|sk-[A-Za-z0-9]{32,}|gh[pousr]_[A-Za-z0-9]{30,}|github_pat_\w{30,}|AKIA[0-9A-Z]{16}"
               r"|AIza[\w-]{35}|xox[abprs]-[\w-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----"
               r"|(?i:(api[_-]?key|secret|token|passw(or)?d)[\"']?\s*[:=]\s*[\"']?[\w/+=]{20,})")


def keep_secrets_out():
    """Unstage files that look like they hold a secret, keep them out of git from now on, and note them: the repo
    syncs to a remote, and history can't be taken back."""
    import re
    # --no-renames: a file renamed and edited in one go shows as added, so it's checked too
    r = git("diff", "--cached", "--name-only", "-z", "--no-renames", "--diff-filter=AMT")
    if r.returncode != 0:
        return False  # couldn't check: the caller commits nothing
    names = r.stdout.split("\0")
    found = []
    for f in filter(None, names):
        if f == ".baton/baton":
            continue
        bad = re.search(SECRET_NAME, f)
        if not bad:
            try:
                with open(os.path.join(BATON, f), encoding="utf-8", errors="replace") as fh:
                    bad = re.search(SECRET_TEXT, fh.read(4_000_000))  # the first 4 MB of even a big file
            except OSError:
                pass
        if bad:
            found.append(f)
    if not found:
        return True
    # synced before: the repo keeps its last clean version (deleting it would delete it on every other machine)
    held = [f for f in found if git("cat-file", "-e", f"HEAD:{f}").returncode == 0]
    new = [f for f in found if f not in held]
    if held:
        git("reset", "-q", "--", *held)
    if new:
        git("rm", "--cached", "-q", "--", *new)
        os.makedirs(os.path.join(BATON, ".git", "info"), exist_ok=True)
        with open(os.path.join(BATON, ".git", "info", "exclude"), "a") as out:
            out.write("".join(f"/{f}\n" for f in new))
    with open(os.path.join(BATON, ".git", "baton-secrets"), "a") as out:
        out.write("".join(f"{f} (new: kept out of git)\n" for f in new)
                  + "".join(f"{f} (synced before: its last clean version stays synced; this change stays here until the "
                            f"secret is taken out of the file)\n" for f in held))
    return True


def commit_all():
    git("add", "-A")
    if not keep_secrets_out():
        git("reset", "-q")
        return False
    if git("diff", "--cached", "--quiet").returncode == 0:
        return False
    where = ("cloud" if os.environ.get("CLAUDE_CODE_REMOTE") == "true"
             else config().get("machine") or ("mac" if sys.platform == "darwin" else "linux"))
    git("commit", "-q", "-m", f"baton: {where} {time.strftime('%Y-%m-%d %H:%M', time.gmtime())} UTC")
    return True


def unstick():
    """A rebase or merge left half done (git was killed mid-sync, or someone is merging by hand). False while it's
    under 10 minutes old: sync then commits nothing, so nothing lands on a half-done state. After that: set the
    edits aside (and save them as a patch in .git), undo it, and bring the edits back."""
    for state in ("rebase-merge", "rebase-apply", "MERGE_HEAD"):
        p = os.path.join(BATON, ".git", state)
        if not os.path.exists(p):
            continue
        if time.time() - os.path.getmtime(p) < 600:
            return False
        import shutil
        stamp = time.strftime("baton-undone-%Y%m%d-%H%M%S")
        patch = os.path.join(BATON, ".git", stamp + ".patch")
        diff = git("diff", "HEAD").stdout
        write(patch, diff)
        # the clashing files: their working copies (maybe resolved by hand) are kept in .git/<stamp>/, then they go
        # back to the half-done state's own version (the undo restores this side's) so the stash takes every other edit
        unmerged = list(filter(None, git("diff", "--name-only", "--diff-filter=U", "-z").stdout.split("\0")))
        for f in unmerged:
            src = os.path.join(BATON, f)
            if os.path.isfile(src):
                os.makedirs(os.path.dirname(os.path.join(BATON, ".git", stamp, f)), exist_ok=True)
                shutil.copy2(src, os.path.join(BATON, ".git", stamp, f))
            if git("checkout", "-q", "HEAD", "--", f).returncode != 0:
                git("rm", "-q", "--cached", "--", f)
        if unmerged:
            notice(f"A sync that got stuck mid-merge was undone. The files it was merging ({', '.join(unmerged)}) are "
                   f"back to this computer's version; the half-merged copies are kept in {tilde(BATON)}/.git/{stamp}/. "
                   f"If someone had fixed them by hand, copy the fix back.")
        stashed = set_aside()
        if git("rebase", "--abort").returncode != 0 and git("merge", "--abort").returncode != 0:
            git("reset", "-q", "--merge")
        bring_back(stashed)
        if diff.strip() and not stashed and git("apply", "--3way", patch).returncode != 0:
            notice(f"Edits made while a sync was stuck couldn't be put back by themselves; they're saved in "
                   f"{tilde(patch)}. Apply them (git apply --3way) or copy the lines in by hand.")
        break
    return True


def set_aside():
    """Stash uncommitted edits to tracked files (held secrets, edits during a stuck merge). True if any were."""
    if not git("status", "--porcelain", "--untracked-files=no").stdout.strip():
        return False
    before = rev("refs/stash")
    git("stash", "push", "-q", "-m", "baton: set aside during sync")
    return rev("refs/stash") != before


def bring_back(stashed):
    if stashed and git("stash", "pop", "-q").returncode != 0:
        git("reset", "-q", "--merge")  # the edit clashed with the remote's; it stays safe in the stash
        notice(f"An edit clashed with the remote's version and is kept in {tilde(BATON)}'s git stash "
               f"(`git stash show -p`); put it back by hand, then `git stash drop`.")


def notice(text):
    with open(os.path.join(BATON, ".git", "baton-notice"), "a") as out:
        out.write(text.replace("\n", " ") + "\n")


def integrate(target):
    """Bring the remote in: a rebase when it applies (text clashes merge themselves through the merge driver),
    else a merge that keeps this side of anything left and saves the other side next to it as NAME.other.EXT."""
    if git("merge-base", "--is-ancestor", target, "HEAD").returncode == 0:
        return True
    if git("rebase", "-q", target).returncode == 0:
        return True
    git("rebase", "--abort")
    if git("merge", "-q", "--no-edit", target).returncode == 0:
        return True
    unmerged = git("diff", "--name-only", "--diff-filter=U", "-z").stdout.split("\0")
    for f in filter(None, unmerged):
        if git("cat-file", "-e", f":2:{f}").returncode == 0:
            git("checkout", "--ours", "--", f)
            import subprocess
            theirs = subprocess.run(["git", "show", f":3:{f}"], cwd=BATON, capture_output=True)  # bytes: may be binary
            if theirs.returncode == 0:
                stem, ext = os.path.splitext(f)
                with open(os.path.join(BATON, f"{stem}.other{ext}"), "wb") as out:
                    out.write(theirs.stdout)
        else:  # deleted here, changed there: keep the changed file
            git("checkout", "--theirs", "--", f)
        log_merged(f)
    git("add", "-A")
    if keep_secrets_out() and git("commit", "-q", "--no-edit").returncode == 0:
        return True
    git("merge", "--abort")
    return False


def sync(push=True, wait=0):
    """Commit, bring in the remote, push. Never blocks other syncs (one at a time) and never loses work."""
    if not is_repo():
        return "no shared repo: run `baton init`"
    import fcntl
    lock = open(os.path.join(BATON, ".git", "baton.lock"), "w")
    deadline = time.time() + wait
    while True:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            break
        except OSError:
            if time.time() >= deadline:
                return "another sync is running"
            time.sleep(0.2)
    try:
        ensure_merge_driver()
        refresh_vendored()
        if not unstick():
            return "a merge is in progress; the next sync tries again"
        commit_all()
        if not has_remote():
            return "saved (no remote yet: `baton init --remote URL`)"
        b = branch()
        for attempt in range(3):
            if git("fetch", "-q", "origin", timeout=30).returncode != 0:
                return "saved here; couldn't reach the remote"
            target = upstream()
            stashed = set_aside() if target else False
            merged = integrate(target) if target else True
            bring_back(stashed)
            if not merged:
                return "saved here; couldn't merge with the remote (left for the next sync)"
            if not push:
                return "pulled"
            if target and rev("HEAD") == rev(target):
                return "in sync"
            if git("push", "-q", "origin", f"HEAD:refs/heads/{b}", timeout=60).returncode == 0:
                if not target:
                    git("branch", "-q", "--set-upstream-to", f"origin/{b}")
                return "in sync"
            time.sleep(attempt + 1)  # someone pushed in between: fetch and merge again
        return "saved here; push failed (the next sync retries)"
    finally:
        lock.close()


def log_merged(path):
    with open(os.path.join(BATON, ".git", "baton-merged"), "a") as f:
        f.write(path + "\n")


# ---------------------------------------------------------------- merge driver (keeps both sides)

def cmd_merge(args):
    """git merge driver: baton merge BASE OURS THEIRS PATH. Writes OURS; exit 1 leaves the clash to sync()."""
    base_p, ours_p, theirs_p, path = args[:4]
    try:
        ours, base, theirs = (open(p, encoding="utf-8", newline="").read() for p in (ours_p, base_p, theirs_p))
    except (UnicodeDecodeError, OSError):
        return 1
    if "\0" in ours + base + theirs:
        return 1  # binary, even when its bytes happen to read as text: never mix lines
    if path == ".baton/baton":  # the cloud copy of baton: the newer version wins, never a mix
        if version_of(theirs) > version_of(ours):
            with open(ours_p, "w", encoding="utf-8", newline="") as f:
                f.write(theirs)
        return 0
    result = "".join(union(lines(base), lines(ours), lines(theirs)))
    if ours and not ours.endswith("\n") and result.endswith("\n"):
        result = result[:-1]
    if path.endswith(".json"):
        import json
        try:
            json.loads(result)
        except ValueError:
            return 1
    if path.endswith(".py"):
        try:
            compile(result, path, "exec")
        except (SyntaxError, ValueError):
            return 1
    with open(ours_p, "w", encoding="utf-8", newline="") as f:
        f.write(result)
    if ours != theirs:
        try:
            log_merged(path)
        except OSError:
            pass
    return 0


def lines(text):
    return [x if x.endswith("\n") else x + "\n" for x in text.splitlines(True)]


def changes(base, side):
    import difflib
    ops = difflib.SequenceMatcher(None, base, side, autojunk=False).get_opcodes()
    return [(i1, i2, side[j1:j2]) for tag, i1, i2, j1, j2 in ops if tag != "equal"]


def version(base, lo, hi, side_changes):
    out, i = [], lo
    for i1, i2, new in side_changes:
        out += base[i:i1] + new
        i = i2
    return out + base[i:hi]


def keep_both(x, y):
    import difflib
    if x == y:
        return x
    out = []
    for tag, i1, i2, j1, j2 in difflib.SequenceMatcher(None, x, y, autojunk=False).get_opcodes():
        out += x[i1:i2] if tag == "equal" else x[i1:i2] + y[j1:j2]
    return out


def union(base, ours, theirs):
    """Three-way merge that applies every change from both sides. Where both changed the same lines (or added
    lines at the same spot) this side's lines come first, then the other's, shared lines once. Unlike
    `git merge-file --union`, clashes a few lines apart stay separate, so lines between them aren't doubled."""
    a, b = changes(base, ours), changes(base, theirs)
    out, i, ia, ib = [], 0, 0, 0
    clash = lambda c, d: (c[0] < d[1] and d[0] < c[1]) or (c[0] == c[1] == d[0] == d[1])
    while ia < len(a) or ib < len(b):
        ca = a[ia] if ia < len(a) else None
        cb = b[ib] if ib < len(b) else None
        if ca and cb and clash(ca, cb):
            ga, gb = [ca], [cb]
            lo, hi = min(ca[0], cb[0]), max(ca[1], cb[1])
            ia, ib, grew = ia + 1, ib + 1, True
            while grew:
                grew = False
                if ia < len(a) and a[ia][0] < hi:
                    ga.append(a[ia]); hi = max(hi, a[ia][1]); ia += 1; grew = True  # noqa: E702
                if ib < len(b) and b[ib][0] < hi:
                    gb.append(b[ib]); hi = max(hi, b[ib][1]); ib += 1; grew = True  # noqa: E702
            out += base[i:lo] + keep_both(version(base, lo, hi, ga), version(base, lo, hi, gb))
            i = hi
            continue
        if cb is None or (ca is not None and ca[:2] <= cb[:2]):
            change, ia = ca, ia + 1
        else:
            change, ib = cb, ib + 1
        out += base[i:change[0]] + change[2]
        i = change[1]
    return out + base[i:]


