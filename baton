            write(p, text)
    refresh_vendored()


def refresh_vendored():
    """Keep a copy of this script in the repo, for cloud sessions (they don't have baton installed)."""
    copy = os.path.join(BATON, ".baton", "baton")
    if same(copy, SCRIPT):
        return
    mine, theirs = read(SCRIPT), read(copy)
    if mine and mine != theirs and (not theirs or version_of(mine) > version_of(theirs)):
        write(copy, mine)
        os.chmod(copy, 0o755)


def version_of(text):
    import re
    m = re.search(r'^VERSION = "([0-9.]+)"', text, re.M)
    return tuple(int(x) for x in m.group(1).split(".")) if m else (0,)


def hook_specs(d):
    c = quote(SCRIPT)
    # after every tool call: a shell check of the ok file (~3 ms) instead of starting Python (~50 ms)
    usage_cmd = f'[ -n "$(find {quote(cache_file(d, "ok"))} -mmin -{FRESH // 60} 2>/dev/null)" ] || exec {c} hook usage'
    specs = {
        "SessionStart": {"hooks": [{"type": "command", "command": f"{c} hook start", "timeout": 60}]},
        "UserPromptSubmit": {"hooks": [{"type": "command", "command": usage_cmd, "timeout": 15}]},
        "PostToolUse": {"matcher": "*", "hooks": [{"type": "command", "command": usage_cmd, "timeout": 15}]},
        "Stop": {"hooks": [{"type": "command", "command": f"{c} hook stop", "async": True, "timeout": 120}]},
    }
    if not features()["handoff"]:
        del specs["UserPromptSubmit"], specs["PostToolUse"]
    return specs


def ours(cmd):
    return "baton" in cmd and any(w in cmd for w in (" hook start", " hook usage", " hook stop", " statusline"))


def backup(path, d):
    """Move a file, folder or link into <account>/baton-backup/ (never overwrites an older backup)."""
    dest = os.path.join(d, "baton-backup", os.path.basename(path))
    if os.path.lexists(dest):
        dest += time.strftime(".%Y%m%d-%H%M%S")
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    os.rename(path, dest)
    return dest


def adopt_claude_md(d):
    """Link the account's CLAUDE.md to the shared one; rules it had join the shared file first."""
    p, shared = os.path.join(d, "CLAUDE.md"), os.path.join(BATON, "CLAUDE.md")
    if os.path.islink(p) and same(p, shared):
        return None
    note = None
    if os.path.lexists(p):
        text = read(p).strip()
        mine = read(shared)
        if text and text not in mine:
            if mine.strip() == CLAUDE_MD.strip():
                write(shared, text + "\n\n" + CLAUDE_MD[CLAUDE_MD.index("## baton"):])
            else:
                write(shared, mine.rstrip() + f"\n\n<!-- from {tilde(p)} -->\n{text}\n")
            note = f"its CLAUDE.md rules moved into {tilde(shared)}"
        backup(p, d)
    os.symlink(shared, p)
    return note


def adopt_dir(d, sub):
    """Link <account>/<sub> to the shared folder; what it held is copied in first (name clashes stay in the backup)."""
    import shutil
    p, shared = os.path.join(d, sub), os.path.join(BATON, sub)
    os.makedirs(shared, exist_ok=True)
    if os.path.islink(p) and same(p, shared):
        return []
    clashes = []
    if os.path.lexists(p):
        src = os.path.realpath(p)
        if os.path.isdir(src):
            for entry in os.listdir(src):
                a, b = os.path.join(src, entry), os.path.join(shared, entry)
                if os.path.lexists(b):
                    if not (os.path.isfile(a) and read(a) == read(b)):
                        clashes.append(f"{sub}/{entry}")
                elif os.path.isdir(a) and not os.path.islink(a):
                    shutil.copytree(a, b, symlinks=True)
                else:
                    shutil.copy2(a, b, follow_symlinks=False)
        backup(p, d)
    os.symlink(shared, p)
    return clashes


def wire_settings(d):
    import json
    p = os.path.join(d, "settings.json")
    try:
        s = json.loads(read(p) or "{}")
    except ValueError:
        raise SystemExit(f"baton: {tilde(p)} isn't valid JSON; fix it and run again")
    if os.path.exists(p) and not os.path.exists(os.path.join(d, "baton-backup", "settings.json")):
        import shutil
        os.makedirs(os.path.join(d, "baton-backup"), exist_ok=True)
        shutil.copy2(p, os.path.join(d, "baton-backup", "settings.json"))
    note = None
    prev = s.get("autoMemoryDirectory")
    if prev and not same(os.path.expanduser(prev), os.path.join(BATON, "memory")):
        cfg = config()
        cfg.setdefault("previous_memory", {})[tilde(d)] = prev
        save_config(cfg)
        note = f"its memory folder {prev} is no longer loaded (restored by `baton leave`); bring its notes into {tilde(BATON)}/memory"
    s["autoMemoryDirectory"] = tilde(os.path.join(BATON, "memory"))
    hooks = s.setdefault("hooks", {})
    specs = hook_specs(d)
    for event in set(hooks) | set(specs):
        groups = hooks.setdefault(event, [])
        for g in groups:
            g["hooks"] = [h for h in g.get("hooks", []) if not ours(h.get("command", ""))]
        groups[:] = [g for g in groups if g.get("hooks")] + ([specs[event]] if event in specs else [])
        if not groups:
            del hooks[event]
    line = s.get("statusLine") or {}
    if features()["statusline"] and (not line or ours(line.get("command", ""))):
        s["statusLine"] = {"type": "command", "command": f"{quote(SCRIPT)} statusline"}
    elif not features()["statusline"] and ours(line.get("command", "")):
        del s["statusLine"]
    write(os.path.realpath(p), json.dumps(s, indent=2) + "\n")  # through a link (dotfile managers)
    return note


def unwire_settings(d):
    import json
    p = os.path.join(d, "settings.json")
    try:
        s = json.loads(read(p) or "{}")
    except ValueError:
        return
    if same(os.path.expanduser(s.get("autoMemoryDirectory", "")), os.path.join(BATON, "memory")):
        s.pop("autoMemoryDirectory")
        prev = config().get("previous_memory", {}).get(tilde(d))
        if prev:
            s["autoMemoryDirectory"] = prev
    for event, groups in list(s.get("hooks", {}).items()):
        for g in groups:
            g["hooks"] = [h for h in g.get("hooks", []) if not ours(h.get("command", ""))]
        s["hooks"][event] = [g for g in groups if g.get("hooks")]
        if not s["hooks"][event]:
            del s["hooks"][event]
    if not s.get("hooks"):
        s.pop("hooks", None)
    if ours((s.get("statusLine") or {}).get("command", "")):
        s.pop("statusLine")
    write(os.path.realpath(p), json.dumps(s, indent=2) + "\n")


def join(d, name):
    d = os.path.abspath(os.path.expanduser(d))
    os.makedirs(d, exist_ok=True)
    notes = [n for n in [adopt_claude_md(d)] if n]
    clashes = [c for sub in SHARED for c in adopt_dir(d, sub)]
    if clashes:
        notes.append("kept the shared copy of " + ", ".join(clashes) + f" (this account's are in {tilde(d)}/baton-backup)")
    notes += [n for n in [wire_settings(d)] if n]
    cfg = config()
    cfg.setdefault("accounts", {})[name] = tilde(d)
    save_config(cfg)
    if not is_default(d):
        notes += launcher(name, d)
    return notes


def launcher(name, d):
    path = os.path.join(BIN, name)
    if os.path.exists(path) and "baton launcher" not in read(path):
        return [f"{tilde(path)} exists and isn't baton's, so start this account with: CLAUDE_CONFIG_DIR={tilde(d)} claude"]
    folder = "$HOME" + d[len(HOME):] if d.startswith(HOME + os.sep) else d
    write(path, f'#!/bin/sh\n# baton launcher: Claude Code on the account in {tilde(d)}\n'
                'command -v claude >/dev/null 2>&1 || PATH="$PATH:$HOME/.local/bin:$HOME/.claude/local"\n'
                f'CLAUDE_CONFIG_DIR="{folder}" exec claude "$@"\n')
    os.chmod(path, 0o755)
    return []


