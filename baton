def cmd_doctor(args):
    import json
    import shutil
    ok = True

    def check(good, text, fix=""):
        nonlocal ok
        ok = ok and good
        print(("ok    " if good else "FIX   ") + text + ("" if good or not fix else f"\n      {fix}"))

    check(sys.version_info >= (3, 8), f"python {sys.version.split()[0]}")
    check(bool(shutil.which("git")), "git", "install git")
    check(bool(shutil.which("claude")), "claude on PATH", "install Claude Code")
    check(BIN in os.environ.get("PATH", "").split(os.pathsep), f"{tilde(BIN)} on PATH", f'add it: export PATH="$HOME/.local/bin:$PATH"')
    check(is_repo(), f"shared repo {tilde(BATON)}", "run `baton init`")
    if is_repo():
        check(has_remote(), "remote for syncing", "baton init --github my-claude   (or --remote URL)")
    for name, d in accounts():
        md = os.path.join(d, "CLAUDE.md")
        try:
            s = json.loads(read(os.path.join(d, "settings.json")) or "{}")
        except ValueError:
            s = {}
        wired = sum(ours(h.get("command", "")) for gs in s.get("hooks", {}).values() for g in gs for h in g.get("hooks", []))
        good = os.path.islink(md) and same(md, os.path.join(BATON, "CLAUDE.md")) and wired >= len(hook_specs(d))
        check(good, f"{name}: rules, memory and hooks linked", f"run `baton {'init' if is_default(d) else 'add ' + name[6:]}` again")
        u = usage(d, max_age=60)
        err = u.get("error")
        check(err in (None, "offline"), f"{name}: " + ("usage readable" if not err else "signed in, usage unknown "
              "(couldn't reach Anthropic)" if err == "offline" else err), f"start it once ({start_cmd(name, d)}) and sign in")
    return 0 if ok else 1


def cmd_update(args):
