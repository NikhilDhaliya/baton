def found_accounts():
    """{folder: how it's started} for every Claude Code account folder on this computer."""
    import glob
    import re
    starts = {}
    for rc in (".bashrc", ".bash_aliases", ".zshrc", ".profile", ".bash_profile", ".zprofile", ".config/fish/config.fish"):
        for line in read(os.path.join(HOME, rc)).splitlines():
            m = re.search(r"CLAUDE_CONFIG_DIR=[\"']?([^\s\"';]+)", line)
            if not m or line.lstrip().startswith("#"):
                continue
            d = os.path.realpath(os.path.expanduser(re.sub(r"\$\{?HOME\}?", HOME, m.group(1))))
            a = re.search(r"(?:alias\s+|function\s+)([\w.-]+)|^\s*([\w.-]+)\s*\(\)", line)
            starts.setdefault(d, []).append(f"`{a.group(1) or a.group(2)}` in ~/{rc}" if a else f"set in ~/{rc}")
    for launcher_path in glob.glob(os.path.join(BIN, "claude?*")):
        if os.path.getsize(launcher_path) > 4096:
            continue  # the claude program itself, not a launcher
        m = re.search(r'CLAUDE_CONFIG_DIR="([^"]+)"', read(launcher_path))
        if m:
            starts.setdefault(os.path.realpath(m.group(1).replace("$HOME", HOME)), []).insert(0, f"`{os.path.basename(launcher_path)}`")
    env_dir = os.environ.get("CLAUDE_CONFIG_DIR")
    if env_dir:
        starts.setdefault(os.path.realpath(os.path.expanduser(env_dir)), []).append("this session's CLAUDE_CONFIG_DIR")
    candidates = [os.path.join(HOME, ".claude")] + sorted(glob.glob(os.path.join(HOME, ".claude-*"))) + list(starts)
    out = {}
    for d in candidates:
        d = os.path.realpath(d)
        looks = any(os.path.exists(os.path.join(d, x)) for x in (".credentials.json", "settings.json", "projects", ".claude.json", "history.jsonl"))
        if os.path.isdir(d) and looks and d not in out:
            out[d] = "`claude`" if is_default(d) else ", ".join(starts.get(d, [])) or "no command found"
    return out


def gh_user():
    """The GitHub CLI's signed-in user, read from its hosts.yml: nothing is run (gh writes state files when it runs),
    nothing is sent, and nothing but the user name is read out."""
    import glob
    import re
    config_home = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
    dirs = [os.environ.get("GH_CONFIG_DIR"), os.path.join(config_home, "gh")]
    dirs += sorted(glob.glob(os.path.join(HOME, "snap", "gh", "*", ".config", "gh")))  # gh installed as a snap
    for d in filter(None, dirs):
        host = re.search(r"^github\.com:[ \t]*\n(.*?)(?=^\S|\Z)", read(os.path.join(d, "hosts.yml")), re.M | re.S)
        user = host and re.search(r"^[ \t]+user:[ \t]*([\w-]+)", host.group(1), re.M)
        if user:
            return user.group(1)
    return None


def describe_link_or_count(d, item):
    p = os.path.join(d, item)
    if os.path.islink(p):
        return f"{item} -> {tilde(os.path.realpath(p))}"
    if item == "CLAUDE.md":
        n = read(p).count("\n")
        return f"CLAUDE.md {n} lines" if os.path.exists(p) else "no CLAUDE.md"
    n = len([x for x in os.listdir(p) if not x.startswith(".")]) if os.path.isdir(p) else 0
    return f"{item} {n}"


def hooks_summary(s):
    """Event(script name) for hooks that aren't baton's; never the full command (it could hold a secret)."""
    import shlex
    out = []
    for event, groups in (s.get("hooks") or {}).items():
        for g in groups:
            for h in g.get("hooks", []):
                cmd = h.get("command", "")
                if ours(cmd):
                    continue
                try:
                    words = shlex.split(cmd)
                except ValueError:
                    words = cmd.split()
                paths = [w for w in words if "/" in w]
                out.append(f"{event}({os.path.basename(paths[0] if paths else (words or ['?'])[0])})")
    return out


def cmd_scan(args):
    import json
    import platform
    import re
    import shutil
    import subprocess

    def run(*cmd):
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=15)
            return r.returncode, (r.stdout + r.stderr).strip()
        except (OSError, subprocess.TimeoutExpired):
            return 127, ""

    print("baton scan: reads files on this computer only; changes nothing, sends nothing" if "--usage" not in args
          else "baton scan --usage: also reads each account's usage from Anthropic with its sign-in", "\n")
    osname = f"macOS {platform.mac_ver()[0]}" if sys.platform == "darwin" else f"{platform.system()} {platform.release()}"
    git_v = run("git", "--version")[1].replace("git version ", "") or "MISSING"
    claude_v = run("claude", "--version")[1].split(" ")[0] if shutil.which("claude") else None
    print(f"system    {osname} · python {platform.python_version()} · git {git_v} · "
          + (f"Claude Code {claude_v}" if claude_v else "`claude` command NOT on PATH (account commands and handoff need it)"))
    if shutil.which("gh"):
        user = gh_user()
        print("github    " + (f"gh signed in as {user} (init --github NAME can create the private repo)" if user
                                else "gh installed, not signed in (the user runs `gh auth login`, or gives a repo URL)"))
    else:
        print("github    gh not installed (sync needs a private repo URL from the user: init --remote URL)")
    w = window_method()
    print(f"windows   {'new terminal windows via ' + w if w else 'no window opener (handoff prints a command to paste)'}")
    print(f"PATH      {tilde(BIN)} " + ("is on PATH" if BIN in os.environ.get("PATH", "").split(os.pathsep) else "is NOT on PATH"))
    if is_repo():
        remote = redact(git("remote", "get-url", "origin").stdout.strip()) or "no remote"
        print(f"baton     set up: {tilde(BATON)} ({remote}); accounts: {', '.join(n for n, _ in accounts()) or 'none'}; "
              f"features: {', '.join(k for k, v in features().items() if v) or 'none'}")
    else:
        print("baton     not set up" + (f" ({tilde(BATON)} exists but isn't a git repo)" if os.path.exists(BATON) else ""))

    found = found_accounts()
    print(f"\naccounts  {len(found)}")
    for d, start in found.items():
        signed = signed_in(d)
        u = read_usage(d) if signed and "--usage" in args else {"error": "not signed in" if not signed else "skipped"}
        if not signed:
            state = "not signed in (start it once and /login)"
        elif u.get("error") == "skipped":
            state = "signed in"
        elif u.get("error") == "offline":
            state = "signed in · usage unknown (couldn't reach Anthropic)"
        elif u.get("error"):
            state = "signed in, but " + u["error"]
        else:
            state = f"signed in · 5-hour {pct_text(u.get('five'))} · weekly {pct_text(u.get('week'))}"
        try:
            st = json.loads(read(os.path.join(d, "settings.json")) or "{}")
        except ValueError:
            st = {}
        joined = any(same(d, ad) for _, ad in accounts())
        print(f"  {tilde(d)}  ({'joined' if joined else 'not joined'}; started with {start})")
        print(f"    {state}")
        print("    " + " · ".join(describe_link_or_count(d, x) for x in ("CLAUDE.md",) + SHARED))
        own_hooks = hooks_summary(st)
        line = st.get("statusLine") or {}
        print("    hooks: " + (", ".join(own_hooks) if own_hooks else "none") + " · status line: "
              + ("baton" if ours(line.get("command", "")) else "their own" if line else "none")
              + " · memory folder: " + (st.get("autoMemoryDirectory") or "per project (default)"))
        mem = [f for f in __import__("glob").glob(os.path.join(d, "projects", "*", "memory", "*.md"))]
        if mem:
            projects = {os.path.basename(os.path.dirname(os.path.dirname(f))) for f in mem}
            print(f"    per-project memory: {len(mem)} files in {len(projects)} projects ({tilde(d)}/projects/*/memory)")
    return 0

