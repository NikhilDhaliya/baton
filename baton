def need_repo():
    if not is_repo() or not accounts():
        raise SystemExit("baton: not set up yet; run `baton init`")


def opt(args, flag):
    if flag in args:
        i = args.index(flag)
        if i + 1 < len(args):
            return args[i + 1]
        raise SystemExit(f"baton: {flag} needs a value")
    return None


def cmd_init(args):
    import shutil
    if not shutil.which("git"):
        raise SystemExit("baton: needs git")
    remote, gh = opt(args, "--remote"), opt(args, "--github")
    fresh = not is_repo()
    chosen = {f: (f"--{f}" in args) or None for f in ("handoff", "statusline")}
    chosen.update({f: False for f in ("handoff", "statusline") if f"--no-{f}" in args})
    if fresh and remote:
        os.makedirs(os.path.dirname(BATON), exist_ok=True)
        r = git("clone", "-q", remote, BATON, cwd=os.path.dirname(BATON), timeout=120)
        if r.returncode != 0:
            raise SystemExit(redact(f"baton: couldn't clone {remote}:\n{r.stderr.strip()}"))
    elif fresh:
        os.makedirs(BATON, exist_ok=True)
        git("init", "-q")
        git("symbolic-ref", "HEAD", "refs/heads/main")
    elif remote and not has_remote():
        git("remote", "add", "origin", remote)
    scaffold()
    ensure_merge_driver()
    cfg = config()
    cfg.setdefault("features", {}).update({f: v for f, v in chosen.items() if v is not None})
    save_config(cfg)
    notes = join(os.path.join(HOME, ".claude"), "claude")
    for _, d in accounts():
        if not is_default(d):
            wire_settings(d)  # features may have changed
    commit_all()
    if gh:
        if not shutil.which("gh"):
            raise SystemExit("baton: --github needs the GitHub CLI (gh); or create a private repo and use --remote URL")
        if not has_remote():
            import subprocess
            r = subprocess.run(["gh", "repo", "create", gh, "--private", "--source", BATON, "--remote", "origin", "--push"],
                               capture_output=True, text=True)
            if r.returncode != 0:
                raise SystemExit(redact(f"baton: gh repo create failed:\n{r.stderr.strip()}"))
    status = sync(push=True, wait=30)
    print(f"Shared repo: {tilde(BATON)} ({status})")
    print("Joined: claude (~/.claude)" + "".join(f"\n  {n}" for n in notes))
    print("\nNext: `baton add` adds an account (~/.claude-b, started with `claudeb`). Restart open Claude sessions to load the hooks.")
    if not has_remote():
        print("Sync across machines and cloud sessions: `baton init --github my-claude` (private repo), or --remote URL.")
    return 0


def cmd_add(args):
    import re
    need_repo()
    folder = opt(args, "--dir")
    args = [a for a in args if a not in ("--dir", folder)]
    if not args:  # the next free letter: b, c, d...
        taken = {n for n, _ in accounts()}
        args = [next(x for x in "bcdefghijklmnopqrstuvwxyz"
                     if "claude" + x not in taken and not os.path.exists(os.path.join(HOME, ".claude-" + x)))]
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,30}", args[0]):
        raise SystemExit("usage: baton add [NAME] [--dir FOLDER]   (`baton add` makes ~/.claude-b and claudeb; "
                         "`baton add work` makes ~/.claude-work and claudework)")
    name = "claude" + args[0]
    d = os.path.abspath(os.path.expanduser(folder)) if folder else os.path.join(HOME, ".claude-" + args[0])
    if is_default(d):
        raise SystemExit("baton: ~/.claude is joined by `baton init`")
    if same(d, BATON) or os.path.realpath(d).startswith(os.path.realpath(BATON) + os.sep):
        raise SystemExit(f"baton: an account folder can't be inside {tilde(BATON)}")
    if re.search(r'["$`\\]', d):
        raise SystemExit('baton: the folder name can\'t contain " $ ` or \\')
    notes = join(d, name)
    commit_all()
    print(f"Added {name} ({tilde(d)})." + "".join(f"\n  {n}" for n in notes))
    print(f"Sign it in: run `{name}` and use /login with that account.")
    if BIN not in os.environ.get("PATH", "").split(os.pathsep):
        print(f"Add {tilde(BIN)} to your PATH to use `{name}`.")
    return 0


def cmd_leave(args):
    need_repo()
    if not args:
        raise SystemExit("usage: baton leave DIR   (e.g. baton leave ~/.claude-b)")
    d = os.path.abspath(os.path.expanduser(args[0]))
    if not any(same(d, ad) for _, ad in accounts()):
        raise SystemExit(f"baton: {tilde(d)} isn't a baton account; `baton status` lists them")
    if os.path.exists(os.path.join(d, "settings.json")):
        unwire_settings(d)
    for item in ("CLAUDE.md",) + SHARED:
        p = os.path.join(d, item)
        if os.path.islink(p) and same(os.path.dirname(os.path.realpath(p)), BATON):
            os.remove(p)
            saved = os.path.join(d, "baton-backup", item)
            if os.path.lexists(saved):
                os.rename(saved, p)
            elif item == "CLAUDE.md":
                write(p, read(os.path.join(BATON, "CLAUDE.md")))  # keep the rules it was using
    cfg = config()
    name = next((n for n, ad in accounts() if same(ad, d)), None)
    if name:
        del cfg["accounts"][name]
        save_config(cfg)
        lp = os.path.join(BIN, name)
        if "baton launcher" in read(lp):
            os.remove(lp)
    print(f"{tilde(d)} left baton; its own files are back. The shared repo stays in {tilde(BATON)}.")
    return 0


def pct_text(p):
    return "–" if p is None else f"{float(p):.0f}%"


def cmd_status(args):
    need_repo()
    me, th = current(), threshold()
    rows = [("", "account", "5-hour", "resets", "weekly", "resets")]
    for name, d in accounts():
        u = usage(d, max_age=60)
        mark = "*" if same(d, me) else ""
        if u.get("error"):
            rows.append((mark, name, "–", "", "–", u["error"]))
        else:
            rows.append((mark, name, pct_text(u.get("five")), clock(u.get("five_reset")),
                         pct_text(u.get("week")), clock(u.get("week_reset"), True)))
    widths = [max(len(r[i]) for r in rows) for i in range(6)]
    for r in rows:
        print("  ".join(c.ljust(w) for c, w in zip(r, widths)).rstrip())
    print(f"\nHandoff at {th:.0f}%. * = this shell's account.")
    return 0


def cmd_statusline(args):
    """Claude Code status line: every account's usage, this one in bold. Never waits on the network."""
    if not sys.stdin.isatty():
        sys.stdin.read()
    import json
    import subprocess
    me, parts, stale = current(), [], False
    for name, d in accounts():
        try:
            with open(cache_file(d)) as f:
                u = json.load(f)
        except (OSError, ValueError):
            u = {"at": 0}
        stale = stale or time.time() - u.get("at", 0) > FRESH
        five, week = u.get("five"), u.get("week")
        text = f"{name} " + ("?" if five is None and week is None else pct_text(five))
        if week is not None and week >= 80:
            text += f" (week {week:.0f}%)"
        pct, _, reset = level(u)
        if pct is not None and pct >= 80 and reset:
            text += f" resets {clock(reset, True)}"
        parts.append(f"\033[1m{text}\033[0m" if same(d, me) else text)
    if stale:
        subprocess.Popen([sys.executable, SCRIPT, "refresh"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    print(" · ".join(parts))
    return 0


def cmd_refresh(args):
    import fcntl
    os.makedirs(CACHE, exist_ok=True)
    with open(os.path.join(CACHE, "refresh.lock"), "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return 0
        for _, d in accounts():
            usage(d)
    return 0


